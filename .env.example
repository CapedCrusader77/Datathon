# ============================================================
# POLICEGPT Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# Application
APP_NAME=POLICEGPT
DEBUG=false
ENVIRONMENT=development

# Security — CHANGE THESE IN PRODUCTION!
SECRET_KEY=change-this-to-a-64-character-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://policegpt:secret@localhost:5432/policegpt_db

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jsecret

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policegpt_firs

# LLM — Choose one provider
LLM_PROVIDER=ollama    # Options: ollama | openai | gemini

# Ollama (Local LLM - recommended for offline/secure deployment)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (Optional - requires internet)
OPENAI_API_KEY=sk-your-key-here

# Google Gemini (Optional)
GEMINI_API_KEY=your-gemini-key-here

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/data/uploads

# CORS — Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:3000","https://policegpt.karnataka.gov.in"]

# Monitoring
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/policegpt/audit.log

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
