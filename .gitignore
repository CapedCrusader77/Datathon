# ============================================================
# POLICEGPT — .gitignore
# ============================================================

# ─── Secrets & Environment ───────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ─── Node / Next.js ──────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem

# ─── IDEs ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Docker / Data ───────────────────────────────────────────
data/
*.db
*.sqlite3

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Uploads / Generated ─────────────────────────────────────
uploads/
*.pkl
*.pt
*.bin
